# Config generated by Ghostty Config

title = "👻"
macos-icon = custom
macos-custom-icon = ~/Desktop/ghostty.png
# background-opacity = 0.7
# background-blur = 35
font-size = 14
macos-titlebar-proxy-icon = hidden
quit-after-last-window-closed = true
clipboard-read = allow
copy-on-select = clipboard
mouse-hide-while-typing = true
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true
cursor-opacity = 0.7
macos-titlebar-style = transparent
adjust-cell-height = 20%
window-padding-x = 10,5
adjust-cursor-height = -20%
adjust-cursor-thickness = 10%

theme = Catppuccin Latte
background = #eff1f5
foreground = #4c4f69
selection-background = #EEFF6D
selection-foreground = #4c4f69
cursor-color = #23bab8
cursor-text = #4c4f69
palette = 0=#5c5f77
palette = 1=#d20f39
palette = 2=#40a02b
palette = 3=#df8e1d
palette = 4=#1e66f5
palette = 5=#ea76cb
palette = 6=#179299
palette = 7=#acb0be
palette = 8=#6c6f85
palette = 9=#de293e
palette = 10=#49af3d
palette = 11=#eea02d
palette = 12=#456eff
palette = 13=#fe85d8
palette = 14=#2d9fa8
palette = 15=#bcc0cc

custom-shader = ~/Downloads/ripple_cursor.glsl
custom-shader = ~/Downloads/cursor_warp.glsl
